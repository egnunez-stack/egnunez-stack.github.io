<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Maximize the Magic - Disney Park App</title>
<link href="https://fonts.googleapis.com/css2?family=Cinzel+Decorative:wght@700;900&family=Raleway:wght@300;400;600;700&display=swap" rel="stylesheet">
<style>
  * { margin: 0; padding: 0; box-sizing: border-box; }

  body {
    min-height: 100vh;
    background: #030818;
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: "Raleway", sans-serif;
    overflow: hidden;
    position: relative;
  }

  .bg {
    position: fixed;
    inset: 0;
    background: linear-gradient(135deg,
      #1a0533 0%,
      #0d1a4a 30%,
      #0a2060 55%,
      #0d3a7a 75%,
      #082044 100%
    );
    z-index: 0;
  }

  canvas.stars {
    position: fixed;
    inset: 0;
    z-index: 1;
    pointer-events: none;
  }

  .comet {
    position: fixed;
    width: 3px;
    height: 3px;
    border-radius: 50%;
    background: #FFD700;
    z-index: 2;
    pointer-events: none;
    opacity: 0;
  }

  .card {
    position: relative;
    z-index: 10;
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 60px 50px 50px;
    max-width: 520px;
    width: 90%;
    text-align: center;
  }

  .logo-wrap {
    width: 160px;
    height: 160px;
    border-radius: 50%;
    overflow: hidden;
    box-shadow:
      0 0 0 3px rgba(255,215,0,0.4),
      0 0 30px rgba(255,215,0,0.25),
      0 0 80px rgba(255,215,0,0.1),
      0 20px 60px rgba(0,0,0,0.6);
    margin-bottom: 36px;
    animation: float 4s ease-in-out infinite;
    flex-shrink: 0;
  }

  .logo-wrap img { width: 100%; height: 100%; object-fit: cover; }

  @keyframes float {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-10px); }
  }

  .title {
    font-family: "Cinzel Decorative", cursive;
    font-size: clamp(24px, 5vw, 36px);
    font-weight: 900;
    line-height: 1.2;
    letter-spacing: 1px;
    color: #FFD700;
    text-shadow:
      -2px -2px 0 #000,
       2px -2px 0 #000,
      -2px  2px 0 #000,
       2px  2px 0 #000,
       0 0 20px rgba(255,215,0,0.6),
       0 0 40px rgba(255,215,0,0.3);
    margin-bottom: 18px;
  }

  .tagline {
    font-family: "Raleway", sans-serif;
    font-size: clamp(13px, 2.5vw, 15px);
    font-weight: 300;
    letter-spacing: 2.5px;
    color: rgba(200, 220, 255, 0.8);
    text-transform: uppercase;
    margin-bottom: 40px;
    line-height: 1.8;
  }

  .tagline em {
    font-style: italic;
    color: rgba(255, 215, 0, 0.65);
    font-weight: 400;
    text-transform: none;
    letter-spacing: 1px;
    font-size: 1.05em;
  }

  .divider {
    width: 200px;
    height: 1px;
    background: linear-gradient(90deg, transparent, rgba(255,215,0,0.45), transparent);
    margin-bottom: 36px;
  }

  .download-label {
    font-family: "Raleway", sans-serif;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 3px;
    text-transform: uppercase;
    color: rgba(180, 200, 255, 0.6);
    margin-bottom: 22px;
  }

  .buttons {
    display: flex;
    flex-direction: column;
    gap: 14px;
    width: 100%;
    max-width: 340px;
  }

  .btn {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 14px;
    padding: 16px 28px;
    border-radius: 50px;
    text-decoration: none;
    font-family: "Raleway", sans-serif;
    font-weight: 600;
    font-size: 15px;
    letter-spacing: 0.3px;
    transition: transform 0.25s ease, box-shadow 0.25s ease;
  }

  .btn:hover { transform: translateY(-3px); }
  .btn:active { transform: translateY(0); }

  .btn-apple {
    background: linear-gradient(135deg, #1c1c2e, #151525);
    border: 1px solid rgba(255,215,0,0.3);
    color: #fff;
    box-shadow: 0 4px 24px rgba(0,0,0,0.4), 0 0 0 1px rgba(255,215,0,0.05) inset;
  }
  .btn-apple:hover {
    box-shadow: 0 12px 40px rgba(0,0,0,0.5), 0 0 20px rgba(255,215,0,0.1);
    border-color: rgba(255,215,0,0.5);
  }

  .btn-google {
    background: linear-gradient(135deg, #0d2014, #0a1a10);
    border: 1px solid rgba(80,200,80,0.3);
    color: #fff;
    box-shadow: 0 4px 24px rgba(0,0,0,0.4), 0 0 0 1px rgba(80,200,80,0.05) inset;
  }
  .btn-google:hover {
    box-shadow: 0 12px 40px rgba(0,0,0,0.5), 0 0 20px rgba(80,200,80,0.1);
    border-color: rgba(80,200,80,0.5);
  }

  .btn-icon { font-size: 22px; line-height: 1; }

  .btn-text-wrap {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    line-height: 1;
  }

  .btn-sub {
    font-size: 10px;
    font-weight: 400;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    opacity: 0.55;
    margin-bottom: 4px;
  }

  .btn-name { font-size: 16px; font-weight: 700; }

  .free-badge {
    margin-top: 28px;
    font-size: 11px;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: rgba(160,180,220,0.45);
    font-weight: 400;
  }

  .free-badge span { color: rgba(255,215,0,0.45); font-weight: 600; }
</style>
</head>
<body>

<div class="bg"></div>
<canvas class="stars" id="stars"></canvas>
<div class="comet" id="comet"></div>

<div class="card">
  <div class="logo-wrap">
    <img src="data:image/jpeg;base64," alt="Maximize the Magic logo">
  </div>

  <h1 class="title">Maximize the Magic</h1>

  <p class="tagline">
    plan it or wing it<br>
    <em>&hellip; never stop dreaming</em>
  </p>

  <div class="divider"></div>

  <p class="download-label">Download it for free at</p>

  <div class="buttons">
    <a href="https://apps.apple.com/ar/app/maximize-the-magic/id6766963957?l=en-GB"
       class="btn btn-apple" target="_blank" rel="noopener">
      <span class="btn-icon">&#xf8ff;</span>
      <span class="btn-text-wrap">
        <span class="btn-sub">Download on the</span>
        <span class="btn-name">App Store</span>
      </span>
    </a>

    <a href="https://play.google.com/store/apps/details?id=com.gen.maximizemagic"
       class="btn btn-google" target="_blank" rel="noopener">
      <span class="btn-icon">&#x25B6;</span>
      <span class="btn-text-wrap">
        <span class="btn-sub">Get it on</span>
        <span class="btn-name">Google Play</span>
      </span>
    </a>
  </div>

  <p class="free-badge">Free with ads &nbsp;&middot;&nbsp; <span>No in-app purchases</span></p>
</div>

<script>
const canvas = document.getElementById("stars");
const ctx = canvas.getContext("2d");
let stars = [];
let frame = 0;

function resize() {
  canvas.width = window.innerWidth;
  canvas.height = window.innerHeight;
}

function initStars() {
  stars = [];
  for (let i = 0; i < 240; i++) {
    stars.push({
      x: Math.random() * canvas.width,
      y: Math.random() * canvas.height,
      r: Math.random() * 1.8 + 0.2,
      gold: Math.random() < 0.22,
      speed: Math.random() * 0.7 + 0.2,
      phase: Math.random() * Math.PI * 2
    });
  }
}

function drawStars() {
  ctx.clearRect(0, 0, canvas.width, canvas.height);
  frame++;
  stars.forEach(s => {
    const twinkle = 0.35 + 0.65 * Math.sin(frame * s.speed * 0.04 + s.phase);
    ctx.beginPath();
    ctx.arc(s.x, s.y, s.r, 0, Math.PI * 2);
    if (s.gold) {
      ctx.fillStyle = "rgba(255,215,0," + (twinkle * 0.9).toFixed(2) + ")";
      if (s.r > 1.2) { ctx.shadowBlur = 7; ctx.shadowColor = "rgba(255,215,0,0.55)"; }
    } else {
      ctx.fillStyle = "rgba(200,220,255," + (twinkle * 0.65).toFixed(2) + ")";
      ctx.shadowBlur = 0;
    }
    ctx.fill();
    ctx.shadowBlur = 0;
  });
  requestAnimationFrame(drawStars);
}

resize(); initStars(); drawStars();
window.addEventListener("resize", () => { resize(); initStars(); });

// Comet
const comet = document.getElementById("comet");
function launchComet() {
  const fromTop = Math.random() < 0.55;
  let sx, sy, angle;
  if (fromTop) {
    sx = Math.random() * window.innerWidth * 0.65;
    sy = -8;
    angle = Math.random() * 35 + 20;
  } else {
    sx = -8;
    sy = Math.random() * window.innerHeight * 0.45;
    angle = Math.random() * 25 + 10;
  }
  const dist = Math.hypot(window.innerWidth, window.innerHeight) * 0.78;
  const rad = angle * Math.PI / 180;
  const ex = sx + dist * Math.cos(rad);
  const ey = sy + dist * Math.sin(rad);
  const duration = 850 + Math.random() * 450;
  const tailLen = 110 + Math.random() * 90;
  const shadow = Array.from({length: 20}, (_, i) => {
    const t = (i+1)/20;
    const ox = -Math.cos(rad)*t*tailLen;
    const oy = -Math.sin(rad)*t*tailLen;
    const a = (1-t)*0.75;
    return ox.toFixed(1)+"px "+oy.toFixed(1)+"px "+(t*9).toFixed(1)+"px rgba(255,230,80,"+a.toFixed(2)+")";
  }).join(", ");
  comet.style.left = sx+"px";
  comet.style.top = sy+"px";
  comet.style.opacity = "0";
  comet.style.boxShadow = shadow;
  let start = null;
  function anim(ts) {
    if (!start) start = ts;
    const p = Math.min((ts-start)/duration, 1);
    const ease = p < 0.1 ? p/0.1 : p > 0.82 ? (1-p)/0.18 : 1;
    comet.style.left = (sx+(ex-sx)*p)+"px";
    comet.style.top = (sy+(ey-sy)*p)+"px";
    comet.style.opacity = (ease*0.92).toFixed(2);
    if (p < 1) requestAnimationFrame(anim);
    else { comet.style.opacity="0"; setTimeout(launchComet, 3000 + Math.random()*600); }
  }
  requestAnimationFrame(anim);
}
setTimeout(launchComet, 1400);
</script>
</body>
</html>
